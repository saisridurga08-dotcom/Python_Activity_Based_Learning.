def monitor_food_waste(waste):
    total = sum(waste)
    average = total / len(waste)
    print("Total Food Waste:", total, "kg")
    print("Average Food Waste:", average, "kg")

print("Test Case 1:")
monitor_food_waste([10, 20, 30])

print("Test Case 2:")
monitor_food_waste([5, 10, 15])

print("Test Case 3:")
monitor_food_waste([2, 4, 6])

print("Test Case 4:")
monitor_food_waste([15, 25, 20])

print("Test Case 5:")
monitor_food_waste([8, 12, 10])