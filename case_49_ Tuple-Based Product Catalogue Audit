
def audit_products(products):
    for product in products:
        name, price, quantity = product
        total = price * quantity
        print(name, "Total Value:", total)


# Test Case 1
print("Test Case 1:")
audit_products([("Pen", 10, 5)])

# Test Case 2
print("Test Case 2:")
audit_products([("Book", 50, 4)])

